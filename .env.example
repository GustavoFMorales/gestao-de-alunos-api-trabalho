# Modelo de configuração do ambiente.
# Copie este arquivo para .env e substitua os valores pelos do seu ambiente.

# URL base da API utilizada pelos testes. Deve terminar com barra.
# Exemplo: http://localhost:3000/
BASE_URL='URL base da API'

# Credenciais do administrador, usadas para autenticar as requisições
# que exigem perfil de administrador.
EMAIL_ADMIN='e-mail do administrador'
SENHA_ADMIN='senha do administrador'

# Credenciais do aluno, usadas para autenticar as requisições
# realizadas em nome do próprio aluno.
EMAIL_ALUNO_GUSTAVO='e-mail do aluno'
SENHA_ALUNO_GUSTAVO='senha do aluno'
